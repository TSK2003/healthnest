rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Patients can submit appointments with required fields
    match /appointments/{appointmentId} {
      allow create: if request.resource.data.patientName is string
                    && request.resource.data.phone is string
                    && request.resource.data.service is string
                    && request.resource.data.visitDate is string
                    && request.resource.data.visitTime != null;
      allow read, update, delete: if false; // Protect patient confidentiality; manage via Firebase Console / Admin
    }
  }
}
